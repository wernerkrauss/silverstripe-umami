{
    "name": "wernerkrauss/silverstripe-umami",
    "description": "Umami analytics integration for Silverstripe: SiteConfig settings, environment-gated tracker template and optional vanilla-cookieconsent integration.",
    "type": "silverstripe-vendor-module",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.4",
        "silverstripe/framework": "^6"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "phpunit/phpunit": "^11.3",
        "silverstripe/cms": "^6"
    },
    "suggest": {
        "pixelpoems/silverstripe-vanilla-cookieconsent": "Optional cookie consent integration."
    },
    "autoload": {
        "psr-4": {
            "Netwerkstatt\\Umami\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netwerkstatt\\Umami\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
